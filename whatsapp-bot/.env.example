# --- WhatsApp Cloud API (Meta) ---
# Texto que tú inventas; se pega igual en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambia-esto-por-un-texto-largo
# "Clave secreta de la app" (App Dashboard > Configuración > Básica). Varias apps: separadas por coma
META_APP_SECRET=
# Token permanente de usuario del sistema con permiso whatsapp_business_messaging
WHATSAPP_TOKEN=
# Si cada tienda usa un token distinto: WHATSAPP_TOKEN_<phone_number_id>=...
GRAPH_API_VERSION=v23.0

# --- Tiendas ---
# Si cada tienda tiene su propio número: <phone_number_id>:<tienda> (vitahubchile | finanzas | digital)
# BRAND_PHONE_MAP=111111111111111:vitahubchile,222222222222222:finanzas,333333333333333:digital
BRAND_PHONE_MAP=

# --- Derivación a una persona ---
# Tu WhatsApp personal (con código de país, sin +) para recibir el aviso. Opcional
OWNER_NOTIFY_NUMBER=
# Horas que el bot se queda en silencio tras derivar
HANDOFF_HOURS=12

# --- Respuestas con IA (opcional). Sin esta clave el bot responde con menús y preguntas frecuentes ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
